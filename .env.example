# ---------------------------------------------------------------------------
# MyDay backend environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Required. Long random string: `python -c "import secrets; print(secrets.token_urlsafe(64))"`
DJANGO_SECRET_KEY=

# Django debug flag. Must be False in production.
DEBUG=False

# Full PostgreSQL URL from Render (or SQLite for local dev):
#   postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=

# Comma-separated hostnames the API responds to.
#   Render: yourapp.onrender.com,127.0.0.1,localhost
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API (CORS).
#   Dev:  http://localhost:5173,http://127.0.0.1:5173
#   Prod: https://yourapp.vercel.app
CORS_ALLOWED_ORIGINS=

# Comma-separated origins trusted for CSRF (same as CORS list).
CSRF_TRUSTED_ORIGINS=

# Vault encryption master key, base64-encoded, at least 32 bytes:
#   python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# When REQUIRE_VAULT_MASTER_KEY=1 this is mandatory in production.
VAULT_MASTER_KEY=
REQUIRE_VAULT_MASTER_KEY=False

# BullDrop daily reward cooldown in seconds (default 24h).
BULLDROP_COOLDOWN_SECONDS=86400

# Vault behavior
VAULT_AUTOLOCK_MINUTES=5
VAULT_REVEAL_TTL_SECONDS=30
VAULT_FILE_MAX_SIZE=5242880

# Optional Redis cache URL (Render Redis). Falls back to local memory.
CACHE_URL=

# Optional: SSO / operational
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7
SECURE_SSL_REDIRECT=True
LOG_LEVEL=INFO
JSON_LOGS=False